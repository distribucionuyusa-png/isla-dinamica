<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto MSIX de Isla dinámica (Microsoft Store o instalación de prueba).
  Los valores {{...}} los completa build-msix.ps1 a partir de identity.json:
  en la Microsoft Store salen de Partner Center → la app → Identidad del producto.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Isla dinámica</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Isla dinámica para Windows: música, notificaciones, temporizador, recordatorios y asistente de voz en la parte superior de la pantalla.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-ES" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="IslaDinamica" Executable="IslaDinamica.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Isla dinámica"
        Description="Isla dinámica para Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0B0B" />
      </uap:VisualElements>
      <Extensions>
        <!-- Inicio con Windows: la app lo activa o desactiva según su ajuste (con permiso del usuario). -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="IslaDinamicaStartup" Enabled="false" DisplayName="Isla dinámica" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- App de escritorio (WPF) con acceso completo; la Store pide justificarla al enviar. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Leer las notificaciones de otras apps (con permiso del usuario). -->
    <uap3:Capability Name="userNotificationListener" />
    <Capability Name="internetClient" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>
